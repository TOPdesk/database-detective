# Copy this file to .env and fill in the values for your database, or pass
# the equivalent --flags to tools/run_sql_tests.py. See that script's --help
# for details.

# Which backend to run against: "sqlite", "duckdb", or "mssql".
SQLTEST_BACKEND=mssql

# Which {% if variant == ... %} content ("mssql" or "duckdb") to test.
# Defaults to matching SQLTEST_BACKEND for the duckdb/mssql backends; the
# sqlite backend has no matching variant, so it defaults to running only the
# markers that don't specify a variant. Uncomment to override either way.
# SQLTEST_VARIANT=mssql

# --- sqlite backend ---
# SQLTEST_SQLITE_PATH=dbadetective.sqlite

# --- duckdb backend ---
# SQLTEST_DUCKDB_PATH=dbadetective.duckdb

# --- mssql backend (needs `uv sync --extra mssql`) ---
SQLTEST_MSSQL_HOST=localhost
SQLTEST_MSSQL_PORT=1433
SQLTEST_MSSQL_DATABASE=dbadetective
SQLTEST_MSSQL_USER=streamer
SQLTEST_MSSQL_PASSWORD=streamer
