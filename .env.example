# Copy this file to .env and fill in the values for your database, or pass
# the equivalent --flags to tools/run_sql_tests.py. See that script's --help
# for details.

# Which backend to run against: "sqlite" or "mssql".
SQLTEST_BACKEND=mssql

# --- sqlite backend ---
# SQLTEST_SQLITE_PATH=dbadetective.sqlite

# --- mssql backend (needs `uv sync --extra mssql`) ---
SQLTEST_MSSQL_HOST=localhost
SQLTEST_MSSQL_PORT=1433
SQLTEST_MSSQL_DATABASE=dbadetective
SQLTEST_MSSQL_USER=streamer
SQLTEST_MSSQL_PASSWORD=streamer
